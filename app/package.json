{
  "name": "police-helper",
  "version": "2.0.0",
  "description": "Police Helper - B-Zone V (MDT, dosare, amenzi, overlay)",
  "author": "raull292",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.raull292.policehelper",
    "productName": "Police Helper",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay-preload.js",
      "mdt-overlay-preload.js",
      "index.html",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Police Helper"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raull292",
        "repo": "pdhelperdosare",
        "releaseType": "release"
      }
    ]
  }
}
